# ==============================================================================
# Tailvar Claims Backend Environment Variables Configuration Template
# NOTE: Never commit actual secrets or production credentials to version control.
# ==============================================================================

# Port the Express HTTP server listens on (Render automatically provides process.env.PORT)
PORT=5000

# Environment mode: 'development', 'production', or 'test'
# In production, JWT_SECRET must be at least 32 characters long
NODE_ENV=development

# MongoDB connection URI (must point to a replica set, such as MongoDB Atlas or local replica set)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/tailvar_claims

# Secret key used for signing JSON Web Tokens
# In production, generate a secure random 48-byte hex secret using Node:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_for_production

# JWT expiration duration (e.g. '1d', '12h', '7d')
JWT_EXPIRES_IN=1d

# CORS allowlist: comma-separated list of allowed frontend origins (trailing slashes ignored)
# Example: https://tailvar-claims-frontend.onrender.com,http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173
